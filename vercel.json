{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/llh.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://*.supabase.co; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/assets/vendor/llh-client.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/course-bundles/data-bi-analyst-complete-bundle",
      "destination": "/#kit-analyst",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst-complete",
      "destination": "/#kit-analyst",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst-interview-kit",
      "destination": "/#kit-analyst",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst-bundle",
      "destination": "/#kit-analyst",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst",
      "destination": "/#kit-analyst",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst-bundle/interview-questions",
      "destination": "/#kit-analyst",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst-bundle/data-scientist-genai-engineer-bundle",
      "destination": "/#kit-scientist",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-scientist-genai-engineer-bundle",
      "destination": "/#kit-scientist",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-science",
      "destination": "/#kit-scientist",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-bi-analyst-bundle/data-scientist-genai-engineer-bundle/interview-questions",
      "destination": "/#kit-scientist",
      "permanent": true
    },
    {
      "source": "/course-bundles/data-scientist-genai-engineer-bundle/interview-questions",
      "destination": "/#kit-scientist",
      "permanent": true
    },
    {
      "source": "/course-bundles/machine-learning-interview-kit",
      "destination": "/#kit-engineer",
      "permanent": true
    },
    {
      "source": "/course-bundles/ai-automation-bundle",
